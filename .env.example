# Server
PORT=3000
NODE_ENV=development

# Session
SESSION_SECRET=dawg-dog

# Set to "true" only when running behind HTTPS (production).
# When true, the session cookie gets the "secure" flag and is sent only over HTTPS.
USE_SECURE_COOKIES=false

# Password reset tokens expire after this many minutes
RESET_TOKEN_TTL_MINUTES=60

# Base URL used to build the password-reset link sent by email
APP_BASE_URL=http://localhost:3000

# --- SMTP (used by src/utils/mailer.js to send password-reset emails) ---
# Leave SMTP_HOST/SMTP_USER/SMTP_PASS empty to fall back to logging the
# email to the console instead of actually sending it (useful for local
# development/testing without a real mail server).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="No Reply <no-reply@example.com>"

# --- Google OAuth2 (optional, for src/config/passport.js Google strategy) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
